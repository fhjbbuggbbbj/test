local baseW, baseH = winW, winH
local function slider(label, min, max, def, onCh)
    local card = N("Frame",{Size=UDim2.new(1,0,0,48),BackgroundColor3=C.Card,BorderSizePixel=0}, sScroll)
    Cnr(card,10)
    N("TextLabel",{Size=UDim2.new(1,-70,0,14),Position=UDim2.new(0,14,0,10),BackgroundTransparency=1,Text=label,TextColor3=C.Text,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left}, card)
    local v = N("TextLabel",{Size=UDim2.new(0,50,0,14),Position=UDim2.new(1,-64,0,10),BackgroundTransparency=1,Text=string.format("%.2f",def),TextColor3=C.Dim,Font=Enum.Font.Gotham,TextSize=10,TextXAlignment=Enum.TextXAlignment.Right}, card)
    local tr = N("Frame",{Size=UDim2.new(1,-28,0,5),Position=UDim2.new(0,14,0,32),BackgroundColor3=C.Line,BorderSizePixel=0}, card)
    Cnr(tr,3)
    local pct = (def-min)/(max-min)
    local fill = N("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=S.Accent,BorderSizePixel=0}, tr)
    Cnr(fill,3)
    local knob = N("TextButton",{Size=UDim2.new(0,12,0,12),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(pct,0,0.5,0),BackgroundColor3=Color3.new(1,1,1),Text="",BorderSizePixel=0,AutoButtonColor=false}, tr)
    Cnr(knob,6)
    local dragging = false
    local function upd(inp)
        local rel = math.clamp((inp.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
        local vv = min + rel * (max - min)
        fill.Size = UDim2.new(rel,0,1,0)
        knob.Position = UDim2.new(rel,0,0.5,0)
        v.Text = string.format("%.2f", vv)
        if onCh then pcall(onCh, vv) end
    end
    tr.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i) end end)
    knob.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i) end end)
    UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end

