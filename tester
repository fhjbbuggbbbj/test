        Size = UDim2.new(0,80,1,0), Position = UDim2.new(1,-80,0,0),
        BackgroundColor3 = C.Text, Text = "Send", TextColor3 = C.BG,
        Font = Enum.Font.GothamBold, TextSize = 12, BorderSizePixel = 0, AutoButtonColor = false,
    }, inputRow)
    Cnr(sb,10)

    local FEATURES = {
        {toggle="ESP", aliases={"esp","wh","boxes"}},
        {toggle="Aimbot", aliases={"aimbot","aim"}},
        {toggle="Fly", aliases={"fly","flight","hover"}},
        {toggle="Noclip", aliases={"noclip","ghost","phase"}},
        {toggle="Speed Hack", aliases={"speed","faster"}},
        {toggle="Jump Power", aliases={"jump"}},
        {toggle="Infinite Jump", aliases={"inf jump","infinite jump"}},
        {toggle="Fullbright", aliases={"fullbright","bright"}},
        {toggle="Anti-AFK", aliases={"anti afk","afk"}},
        {toggle="FPS Boost", aliases={"fps boost","fps","perf"}},
    }
    local function findFeat(w)
        if not w then return nil end
        w = w:lower()
        for _, fe in ipairs(FEATURES) do
            for _, a in ipairs(fe.aliases) do
                if w:find(a, 1, true) then return fe.toggle end
            end
        end
    end

    local function add(t, user)
        local m = N("Frame",{
            Size = UDim2.new(1,-16,0,0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = user and C.Text or C.CardHi, BorderSizePixel = 0,
        }, ms)
        if not m then return end
        Cnr(m,10); Pad(m,8,8,12,12)
        local l = N("TextLabel",{
            Size = UDim2.new(1,-8,0,0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = (user and "You: " or "Nono: ")..t,
            TextColor3 = user and C.BG or C.Text,
            Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, m)
        m.Size = UDim2.new(1,-16,0,l.AbsoluteSize.Y+16)
        task.defer(function() pcall(function() ms.CanvasPosition = Vector2.new(0,math.max(0, ml.AbsoluteContentSize.Y - 260)) end) end)
    end

    local function handle(input)
        local s = input:lower():gsub("[?!.,;:]", " "):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
        local s2 = s:gsub("^(hey|yo|hi|hello|ok|okay|please|pls|plz|can you|make me|give me|let me) ", "")
        
        if s2:find("help") then return "Try: `enable esp`, `disable fly`, `scan game`, `status`." end
        if s2:match("^hi$") or s2:match("^hey$") or s2:match("^yo$") then return "Yo chief." end
        if s2:find("scan") then return "Open the Scanner tab and tap Scan Game." end
        
        local isOff = s2:find("disable") or s2:find("turn off") or s2:find("stop") or s2:find("off")
        local target = s2:gsub("enable ", ""):gsub("disable ", ""):gsub("turn on ", ""):gsub("turn off ", ""):gsub(" on$", ""):gsub(" off$", ""):gsub("^the ", "")
        local toggle = findFeat(target)
        if toggle then
            local setter = S["setToggle_"..toggle]
            if setter then
                setter(not isOff)
                return "**"..toggle.."** "..(isOff and "OFF." or "ON.")
            end
        end
        
        return "Try: `enable esp`, `disable fly`, `scan game`, `help`."
    end

    local function send()
        local t = ib.Text
        if t == "" then return end
        ib.Text = ""
        add(t, true)
        task.wait(0.1)
        local ok, r = pcall(function() return handle(t) end)
        add(ok and r or "Glitched.", false)
    end

    sb.MouseButton1Click:Connect(send)
    ib.FocusLost:Connect(function(e) if e then send() end end)
    task.defer(function() add("Yo chief. Try `enable esp` or `help`.", false) end)
end

