    -- full parse with multiple action support
    local function parse(q)
        local raw = q
        local s = q:lower():gsub("[?!.,;:]"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
        -- strip prefixes aggressively
        local prefixes = {"hey nono ","yo nono ","hi nono ","nono ","please ","pls ","plz ","could you ","can you ","would you ","i want to ","i want ","i need to ","i need ","make me ","give me ","let me ","help me ","wanna ","gimme ","bro ","chief ","dude ","man ","ok ","okay ","alright "}
        local stripped = s
        local changed = true
        while changed do
            changed = false
            for _,p in ipairs(prefixes) do
                if stripped:sub(1,#p) == p then stripped = stripped:sub(#p+1) changed = true end
            end
        end
        s = stripped

        if s:find("scan") and (s:find("game") or s:find("place") or s:find("this")) then return {action="scan", raw=raw} end
        if s:match("^make") or s:match("^write") or s:match("^gen") or s:match("^generate") or s:match("^give me a") or s:match("^create") then
            local target = s:gsub("^make ",""):gsub("^write ",""):gsub("^gen ",""):gsub("^generate ",""):gsub("^give me a ",""):gsub("^give me ",""):gsub("^create ","")
                :gsub("^me ",""):gsub("^a ",""):gsub("^an ",""):gsub("^the ",""):gsub(" script",""):gsub(" for me",""):gsub(" for this game",""):gsub(" for place","")
            return {action="make", query=target, raw=raw}
        end
        if s:match("^what is") or s:match("^whats") or s:match("^what's") or s:match("^explain") or s:match("^how does") then
            return {action="info", query=s:gsub("^what is ",""):gsub("^whats ",""):gsub("^what's ",""):gsub("^explain ",""):gsub("^how does ",""), raw=raw}
        end
        if s:match("^off ") or s:match("^disable ") or s:match("^turn off ") or s:match("^stop ") or s:match(" off$") then
            return {action="off", query=s:gsub("^off ",""):gsub("^disable ",""):gsub("^turn off ",""):gsub("^stop ",""):gsub(" off$",""), raw=raw}
        end
        if s:match("^on ") or s:match("^enable ") or s:match("^turn on ") or s:match("^activate ") or s:match("^use ") or s:match("^start ") then
            local target = s:gsub("^on ",""):gsub("^enable ",""):gsub("^turn on ",""):gsub("^activate ",""):gsub("^use ",""):gsub("^start ","")
            target = target:gsub(" on$",""):gsub("^the ",""):gsub("^my ","")
            return {action="on", query=target, raw=raw}
        end
        -- turn X on/off
        local t1 = s:match("^turn%s+(.+)%s+on$") or s:match("^switch%s+(.+)%s+on$")
        if t1 then return {action="on", query=t1, raw=raw} end
        local t2 = s:match("^turn%s+(.+)%s+off$") or s:match("^switch%s+(.+)%s+off$")
        if t2 then return {action="off", query=t2, raw=raw} end
        local t3 = s:match("^(%S+)%s+on$")
        if t3 then return {action="on", query=t3, raw=raw} end
        local t4 = s:match("^(%S+)%s+off$")
        if t4 then return {action="off", query=t4, raw=raw} end

        -- bare feature name → on
        local feat = findFeature(s)
        if feat then return {action="on", query=s, raw=raw, feature=feat} end

        if s:find("status") or s:find("state") then return {action="status", raw=raw} end
        if s:find("players") or s:find("how many") or s:find("count") then return {action="players", raw=raw} end
        if s:find("ping") then return {action="ping", raw=raw} end
        if s:find("fps") or s:find("lag") then return {action="fps", raw=raw} end
        if s:find("place") or s:find("game id") then return {action="place", raw=raw} end
        if s:find("recommend") or s:find("suggest") or s:find("what should i") or s:find("best for") or s:find("whats good") or s:find("what's good") then return {action="recommend", raw=raw} end
        if s:find("help") or s:find("commands") or s:find("what can you") then return {action="help", raw=raw} end
        if s:match("^hi$") or s:match("^hey$") or s:match("^yo$") or s:match("^sup$") or s:match("^hello$") then return {action="greet", raw=raw} end
        if s:find("thank") or s:match("^ty$") then return {action="thanks", raw=raw} end
        if s:find("stupid") or s:find("dumb") or s:find("useless") then return {action="insult", raw=raw} end
        -- math
        local a,b,op = s:match("(%d+)%s*([%+%-%*/])%s*(%d+)")
        if a and b and op then return {action="math", a=a, b=b, op=op, raw=raw} end
        return {action="unknown", raw=raw}
    end

    local function handleOn(query)
        local feat = findFeature(query)
        if not feat then return "Unknown: `"..query.."`." end
        if S.Toggles[feat.toggle] == nil then return "Not registered." end
        local setter = S["setToggle_"..feat.toggle]
        if setter then setter(true) end
        return "**"..feat.toggle.."** ON."
    end
    local function handleOff(query)
        local feat = findFeature(query)
        if not feat then return "Unknown: `"..query.."`." end
        if S.Toggles[feat.toggle] == nil then return "Not registered." end
        local setter = S["setToggle_"..feat.toggle]
        if setter then setter(false) end
        return "**"..feat.toggle.."** OFF."
    end
    local function handleStatus()
        local on = {}
        for k,v in pairs(S.Toggles) do if v then on[#on+1] = k end end
        local s = #on > 0 and table.concat(on,", ") or "(none)"
        return "**Status**\nPlayers: "..#PL:GetPlayers().."/"..PL.MaxPlayers.."\nPlace: "..game.PlaceId.."\nActive: "..s
    end
    local function handleRecommend()
        local r = {}
        local ping = 0
        pcall(function() ping = math.floor(ST.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        if ping > 150 then r[#r+1]="Ping "..ping.."ms - Combat will lag."
        elseif ping <= 80 then r[#r+1]="Ping "..ping.."ms clean."
        else r[#r+1]="Ping "..ping.."ms mid." end
        if #PL:GetPlayers() >= 20 then r[#r+1]="Big lobby. ESP + Tracers."
        elseif #PL:GetPlayers() <= 5 then r[#r+1]="Tiny lobby. Kill Aura OK."
        else r[#r+1]="Mid lobby. Balanced loadout." end
        if not S.Toggles["FPS Boost"] then r[#r+1]="Try **FPS Boost**." end
        return table.concat(r,"\n")
    end
    local function handleHelp()
        return "**Toggles:** `enable esp` / `turn off fly` / `toggle noclip`\n**Scan:** `scan game`\n**Gen:** `make esp script`, `make aimbot script`, `make fly script`, `make speed script`, `make noclip script`, `make jump script`, `make teleport script`, `make collect script`, `make perf script`, `make remote script`\n**Info:** `what is noclip`\n**Status:** `status` / `recommend`"
    end
    local function handleGreet()
        return "Yo chief. "..#PL:GetPlayers().." online. Try `help` or `scan game`."
    end
    local function handleMath(a,b,op)
        a,b = tonumber(a),tonumber(b)
        local r = op=="+" and a+b or op=="-" and a-b or op=="*" and a*b or op=="/" and a/b
        if r then return "= "..r end
        return "?"
    end

    local function dispatch(p)
        local a = p.action
        if a == "info" then return handleInfo(p.query) end
        if a == "on" then
            if p.feature then
                if S.Toggles[p.feature.toggle] == nil then return "Not registered." end
                local setter = S["setToggle_"..p.feature.toggle]
                if setter then setter(true) end
                return "**"..p.feature.toggle.."** ON."
            end
            return handleOn(p.query)
        end
        if a == "off" then return handleOff(p.query) end
        if a == "scan" then return handleScan() end
        if a == "make" then
            if not p.query or p.query == "" then return "Make what? `make esp script`." end
            return "```lua\n"..genScript(p.query).."\n```"
        end
        if a == "status" then return handleStatus() end
        if a == "recommend" then return handleRecommend() end
        if a == "help" then return handleHelp() end
        if a == "greet" then return handleGreet() end
        if a == "thanks" then return "Anytime. I just pass the gear." end
        if a == "insult" then return "Cool. Still here, chief." end
        if a == "players" then return #PL:GetPlayers().."/"..PL.MaxPlayers.." players." end
        if a == "ping" then
            local ping = 0
            pcall(function() ping = math.floor(ST.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            return "Ping **"..ping.."ms**."
        end
        if a == "fps" then return "Roblox caps at 60 FPS. Try FPS Boost in Perf tab." end
        if a == "place" then return "Place ID `"..game.PlaceId.."`." end
        if a == "math" then return handleMath(p.a, p.b, p.op) end
        return "Not sure. Try `help`, `scan game`, or `make esp script`."
    end

    local function add(t, user)
        local m = N("Frame",{
            Size=UDim2.new(1,-16,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundColor3=user and C.Text or C.CardHi,
            BorderSizePixel=0,
        },ms)
        if not m then return end
        Cnr(m,10)
        Pad(m,8,8,12,12)
        local l = N("TextLabel",{
            Size=UDim2.new(1,-8,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1,
            Text=(user and "You: " or "Nono: ")..t,
            TextColor3=user and C.BG or C.Text,
            Font=Enum.Font.Gotham,TextSize=12,
            TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Left,
        },m)
        m.Size = UDim2.new(1,-16,0,l.AbsoluteSize.Y+16)
        task.defer(function()
            pcall(function() ms.CanvasPosition = Vector2.new(0,math.max(0,ml.AbsoluteContentSize.Y-280)) end)
        end)
    end

    local function send()
        local t = ib.Text
        if t == "" then return end
        ib.Text = ""
        add(t, true)
        task.wait(0.15)
        local ok, reply
        ok, reply = pcall(function() return dispatch(parse(t)) end)
        add(ok and reply or "Brain glitched.", false)
    end

    sb.MouseButton1Click:Connect(send)
    ib.FocusLost:Connect(function(e) if e then send() end end)

    task.defer(function()
        add("Hey chief. I'm smarter now — try `enable esp`, `scan game`, `make esp script`, `what is noclip`, `status`, or `help`.", false)
    end)
end
