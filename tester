-- color trackers: each entry = {obj, prop, themeKey}
local ColorRegistry = {}
local function track(obj, prop, key)
    if not obj then return end
    table.insert(ColorRegistry, {obj = obj, prop = prop, key = key})
end
local function applyTheme()
    for _,entry in ipairs(ColorRegistry) do
        pcall(function()
            entry.obj[entry.prop] = C[entry.key]
        end)
    end
end

