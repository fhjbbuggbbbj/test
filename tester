    local function findFeature(word)
        if not word then return nil end
        word = word:lower():gsub("^the%s+",""):gsub("^my%s+",""):gsub("%s+$","")
        local best, score = nil, 0
        for _,feat in ipairs(FEATURES) do
            for _,alias in ipairs(feat.aliases) do
                if word == alias then
                    if #alias > score then score = #alias best = feat end
                elseif word:find(alias,1,true) or alias:find(word,1,true) then
                    if #alias > score then score = #alias best = feat end
                end
            end
        end
        return best
    end

    local function parse(q)
        local raw = q
        local s = q:lower():gsub("[?!.,;:]"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
        local prefixes = {"hey nono ","yo nono ","hi nono ","nono ","please ","pls ","plz ","could you ","can you ","would you ","i want to ","i want ","i need to ","i need ","make me ","give me ","let me ","help me ","wanna ","gimme ","bro ","chief ","dude ","man ","ok ","okay ","alright "}
        local stripped = s
        local changed = true
        while changed do
            changed = false
            for _,p in ipairs(prefixes) do
                if stripped:sub(1,#p) == p then stripped = stripped:sub(#p+1) changed = true end
            end
        end
        s = stripped

        if s:find("scan") and (s:find("game") or s:find("place") or s:find("this")) then return {action="scan", raw=raw} end
        if s:match("^make") or s:match("^write") or s:match("^gen") or s:match("^give me a") then
            local target = s:gsub("^make ",""):gsub("^write ",""):gsub("^gen ",""):gsub("^give me a ",""):gsub("^give me ","")
                :gsub("^me ",""):gsub("^a ",""):gsub("^the ",""):gsub(" script",""):gsub(" for me",""):gsub(" for this game",""):gsub(" for place","")
            return {action="make", query=target, raw=raw}
        end
        if s:match("^what is") or s:match("^whats") or s:match("^explain") then
            return {action="info", query=s:gsub("^what is ",""):gsub("^whats ",""):gsub("^explain ",""), raw=raw}
        end
        if s:match("^off ") or s:match("^disable ") or s:match("^turn off ") or s:match("^stop ") or s:match(" off$") then
            return {action="off", query=s:gsub("^off ",""):gsub("^disable ",""):gsub("^turn off ",""):gsub("^stop ",""):gsub(" off$",""), raw=raw}
        end
        if s:match("^on ") or s:match("^enable ") or s:match("^turn on ") or s:match("^activate ") then
            local target = s:gsub("^on ",""):gsub("^enable ",""):gsub("^turn on ",""):gsub("^activate ","")
            target = target:gsub(" on$",""):gsub("^the ","")
            return {action="on", query=target, raw=raw}
        end
        local t1 = s:match("^turn%s+(.+)%s+on$") or s:match("^switch%s+(.+)%s+on$")
        if t1 then return {action="on", query=t1, raw=raw} end
        local t2 = s:match("^turn%s+(.+)%s+off$") or s:match("^switch%s+(.+)%s+off$")
        if t2 then return {action="off", query=t2, raw=raw} end
        local t3 = s:match("^(%S+)%s+on$")
        if t3 then return {action="on", query=t3, raw=raw} end
        local t4 = s:match("^(%S+)%s+off$")
        if t4 then return {action="off", query=t4, raw=raw} end

        local feat = findFeature(s)
        if feat then return {action="on", query=s, raw=raw, feature=feat} end

        if s:find("status") then return {action="status", raw=raw} end
        if s:find("players") or s:find("how many") then return {action="players", raw=raw} end
        if s:find("ping") then return {action="ping", raw=raw} end
        if s:find("help") or s:find("commands") then return {action="help", raw=raw} end
        if s:match("^hi$") or s:match("^hey$") or s:match("^yo$") then return {action="greet", raw=raw} end
        if s:find("thank") or s:match("^ty$") then return {action="thanks", raw=raw} end
        local a,b,op = s:match("(%d+)%s*([%+%-%*/])%s*(%d+)")
        if a and b and op then return {action="math", a=a, b=b, op=op, raw=raw} end
        return {action="unknown", raw=raw}
    end

    local function handleScan()
        local r = scanGame()
        local out = {}
        out[#out+1] = "**SCAN "..game.PlaceId.."**"
        out[#out+1] = "Remotes: "..#r.remotes
        for i=1,math.min(5,#r.remotes) do out[#out+1] = "  "..r.remotes[i] end
        out[#out+1] = "Scripts: "..#r.scripts
        for i=1,math.min(5,#r.scripts) do out[#out+1] = "  "..r.scripts[i] end
        out[#out+1] = "NPCs: "..#r.npcs.."  Tools: "..#r.tools
        return table.concat(out,"\n")
    end

