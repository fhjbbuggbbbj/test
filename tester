    local function dispatch(p)
        local a = p.action
        if a == "on" then
            if p.feature then
                if S.Toggles[p.feature.toggle] == nil then return "Not registered." end
                local setter = S["setToggle_"..p.feature.toggle]
                if setter then setter(true) end
                return "**"..p.feature.toggle.."** ON."
            end
            local feat = findFeature(p.query)
            if feat then
                local setter = S["setToggle_"..feat.toggle]
                if setter then setter(true) end
                return "**"..feat.toggle.."** ON."
            end
            return "Unknown: `"..p.query.."`."
        end
        if a == "off" then
            local feat = findFeature(p.query)
            if not feat then return "Unknown." end
            local setter = S["setToggle_"..feat.toggle]
            if setter then setter(false) end
            return "**"..feat.toggle.."** OFF."
        end
        if a == "scan" then return handleScan() end
        if a == "make" then return "```lua\n"..genScript(p.query).."\n```" end
        if a == "help" then return "Try: `enable esp`, `scan game`, `make esp script`, `status`." end
        if a == "greet" then return "Yo chief." end
        if a == "thanks" then return "Anytime." end
        if a == "players" then return #PL:GetPlayers().."/"..PL.MaxPlayers.." players." end
        if a == "status" then
            local on = {}
            for k,v in pairs(S.Toggles) do if v then on[#on+1] = k end end
            return #on > 0 and table.concat(on,", ") or "(nothing on)"
        end
        if a == "math" then
            local x,y = tonumber(p.a),tonumber(p.b)
            local r = p.op=="+" and x+y or p.op=="-" and x-y or p.op=="*" and x*y or p.op=="/" and x/y
            return "= "..r
        end
        return "Not sure. Try `help`."
    end

