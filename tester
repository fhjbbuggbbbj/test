        Font=Enum.Font.GothamBold,TextSize=12,
        BorderSizePixel=0,AutoButtonColor=false,
    },inputRow)
    Cnr(sb,10)

    local FEATURES = {
        {key="esp", toggle="ESP", aliases={"esp","wallhack","wh","boxes","outline"}},
        {key="aimbot", toggle="Aimbot", aliases={"aimbot","aim","lock on"}},
        {key="fly", toggle="Fly", aliases={"fly","flight","hover"}},
        {key="noclip", toggle="Noclip", aliases={"noclip","ghost","phase"}},
        {key="speed", toggle="Speed Hack", aliases={"speed","faster","walk speed"}},
        {key="jump", toggle="Jump Power", aliases={"jump","higher jump"}},
        {key="infjump", toggle="Infinite Jump", aliases={"infinite jump","inf jump"}},
        {key="fullbright", toggle="Fullbright", aliases={"fullbright","bright","light"}},
        {key="antiafk", toggle="Anti-AFK", aliases={"anti afk","afk"}},
        {key="perfFps", toggle="FPS Boost", aliases={"fps boost","fps","boost","perf"}},
    }
    local function findFeature(word)
        if not word then return nil end
        word = word:lower():gsub("^the%s+",""):gsub("%s+$","")
        local best, score = nil, 0
        for _,feat in ipairs(FEATURES) do
            for _,alias in ipairs(feat.aliases) do
                if word == alias then
                    if #alias > score then score = #alias best = feat end
                elseif word:find(alias,1,true) then
                    if #alias > score then score = #alias best = feat end
                end
            end
        end
        return best
    end

    local function parse(q)
        local s = q:lower():gsub("[?!.,;:]"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
        local prefixes = {"hey nono ","yo nono ","nono ","please ","pls ","plz ","can you ","make me ","give me ","enable ","turn on ","disable ","turn off ","off ","on "}
        local stripped = s
        local changed = true
        while changed do
            changed = false
            for _,p in ipairs(prefixes) do
                if stripped:sub(1,#p) == p then stripped = stripped:sub(#p+1) changed = true end
            end
        end
        s = stripped

        if s:find("scan") then return {action="scan"} end
        if s:match("^make") or s:match("^gen") then
            return {action="make", query=s:gsub("^make ",""):gsub("^gen ",""):gsub(" script","")}
        end
        if s:match("^off ") or s:match("^disable ") or s:match(" off$") then
            return {action="off", query=s:gsub("^off ",""):gsub("^disable ",""):gsub(" off$","")}
        end
        if s:match("^on ") or s:match("^enable ") or s:match(" on$") then
            return {action="on", query=s:gsub("^on ",""):gsub("^enable ",""):gsub(" on$","")}
        end
        local feat = findFeature(s)
        if feat then return {action="on", query=s, feature=feat} end
        if s:find("help") then return {action="help"} end
        if s:match("^hi$") or s:match("^hey$") or s:match("^yo$") then return {action="greet"} end
        return {action="unknown"}
    end

    local function dispatch(p)
        if p.action == "on" then
            local feat = p.feature or findFeature(p.query or "")
            if not feat then return "Unknown." end
            local setter = S["setToggle_"..feat.toggle]
            if setter then setter(true) end
            return "**"..feat.toggle.."** ON."
        end
        if p.action == "off" then
            local feat = findFeature(p.query or "")
            if not feat then return "Unknown." end
            local setter = S["setToggle_"..feat.toggle]
            if setter then setter(false) end
            return "**"..feat.toggle.."** OFF."
        end
        if p.action == "scan" then return "Scanning... (feature in Scanner tab)" end
        if p.action == "make" then return "```lua\n-- "..(p.query or "esp").." script for "..game.PlaceId.."\nlocal PL=game:GetService('Players')\n-- ...(see Scanner tab for full generation)\n```" end
        if p.action == "help" then return "Try: `enable esp`, `scan game`, `make esp script`, `status`." end
        if p.action == "greet" then return "Yo chief." end
        return "Not sure. Try `help`."
    end

    local function add(t, user)
        local m = N("Frame",{
            Size=UDim2.new(1,-16,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundColor3=user and C.Text or C.CardHi,
            BorderSizePixel=0,
        },ms)
        if not m then return end
        Cnr(m,10)
        Pad(m,8,8,12,12)
        local l = N("TextLabel",{
            Size=UDim2.new(1,-8,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1,
            Text=(user and "You: " or "Nono: ")..t,
            TextColor3=user and C.BG or C.Text,
            Font=Enum.Font.Gotham,TextSize=12,
            TextWrapped=true,
            TextXAlignment=Enum.TextXAlignment.Left,
        },m)
        m.Size = UDim2.new(1,-16,0,l.AbsoluteSize.Y+16)
        task.defer(function()
            pcall(function() ms.CanvasPosition = Vector2.new(0,math.max(0,ml.AbsoluteContentSize.Y-280)) end)
        end)
    end

    local function send()
        local t = ib.Text
        if t == "" then return end
        ib.Text = ""
        add(t, true)
        task.wait(0.1)
        local ok, reply = pcall(function() return dispatch(parse(t)) end)
        add(ok and reply or "Brain glitched.", false)
    end

    sb.MouseButton1Click:Connect(send)
    ib.FocusLost:Connect(function(e) if e then send() end end)

    task.defer(function()
        add("Hey chief. Try `enable esp`, `scan game`, `help`.", false)
    end)
end
