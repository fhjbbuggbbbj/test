-- process pending callbacks at fixed rate (no more per-heartbeat loop)
local cbAccum = 0
RS.Heartbeat:Connect(function(dt)
    cbAccum = cbAccum + dt
    if cbAccum < 0.05 then return end   -- max 20 per second
    cbAccum = 0
    while #pending > 0 do
        local f = table.remove(pending, 1)
        pcall(f)
    end
end)

