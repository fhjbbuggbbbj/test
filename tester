local function slider(label, min, max, def, onChange)
    local card = N("Frame",{Size=UDim2.new(1,0,0,46),BackgroundColor3=C.Card,BorderSizePixel=0}, sScroll)
    Cnr(card,8)
    N("TextLabel",{Size=UDim2.new(1,-70,0,14),Position=UDim2.new(0,12,0,8),BackgroundTransparency=1,Text=label,TextColor3=C.Text,Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left}, card)
    local val = N("TextLabel",{Size=UDim2.new(0,50,0,14),Position=UDim2.new(1,-62,0,8),BackgroundTransparency=1,Text=string.format("%.1f",def),TextColor3=C.Dim,Font=Enum.Font.Gotham,TextSize=10,TextXAlignment=Enum.TextXAlignment.Right}, card)
    local tr = N("Frame",{Size=UDim2.new(1,-24,0,6),Position=UDim2.new(0,12,0,30),BackgroundColor3=C.Line,BorderSizePixel=0}, card)
    Cnr(tr,3)
    local pct = (def-min)/(max-min)
    local fill = N("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=S.Accent,BorderSizePixel=0}, tr)
    Cnr(fill,3)
    local knob = N("TextButton",{Size=UDim2.new(0,14,0,14),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(pct,0,0.5,0),BackgroundColor3=Color3.new(1,1,1),Text="",BorderSizePixel=0,AutoButtonColor=false}, tr)
    Cnr(knob,7)
    local dragging = false
    local function upd(inp)
        local rel = math.clamp((inp.Position.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
        local v = min + rel * (max - min)
        fill.Size = UDim2.new(rel,0,1,0)
        knob.Position = UDim2.new(rel,0,0.5,0)
        val.Text = string.format("%.1f", v)
        if onChange then pcall(onChange, v) end
    end
    tr.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i) end end)
    knob.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i) end end)
    UIS.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end

