-- TOGGLE BUILDER — instant, no tween
-- ═══════════════════════════════════════════════
local function makeToggle(parent, name, desc, def, cb)
    local row = N("Frame",{
        Size = UDim2.new(1,0,0,52), BackgroundColor3 = C.Card, BorderSizePixel = 0,
    }, parent)
    if not row then return end
    Cnr(row, 10); Strk(row, C.Line, 1)

    N("TextLabel",{
        Size = UDim2.new(1,-80,0,18), Position = UDim2.new(0,14,0,10),
        BackgroundTransparency = 1, Text = name, TextColor3 = C.Text,
        Font = Enum.Font.GothamMedium, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    if desc and desc ~= "" then
        N("TextLabel",{
            Size = UDim2.new(1,-80,0,14), Position = UDim2.new(0,14,0,28),
            BackgroundTransparency = 1, Text = desc, TextColor3 = C.Dim,
            Font = Enum.Font.Gotham, TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
    end

    local track = N("Frame",{
        Size = UDim2.new(0,48,0,26), Position = UDim2.new(1,-62,0.5,-13),
        BackgroundColor3 = C.Line, BorderSizePixel = 0,
    }, row)
    Cnr(track, 13)

    local knob = N("Frame",{
        Size = UDim2.new(0,20,0,20), Position = UDim2.new(0,3,0.5,-10),
        BackgroundColor3 = C.Text, BorderSizePixel = 0,
    }, track)
    Cnr(knob, 10)

    local btn = N("TextButton",{
        Size = UDim2.new(0,48,0,26), Position = UDim2.new(1,-62,0.5,-13),
        BackgroundTransparency = 1, Text = "", BorderSizePixel = 0,
    }, row)

    local on = def or false
    S.Toggles[name] = on

    local function paint()
        if on then
            track.BackgroundColor3 = S.Accent
            knob.Position = UDim2.new(1,-23,0.5,-10)
            knob.BackgroundColor3 = C.BG
        else
            track.BackgroundColor3 = C.Line
            knob.Position = UDim2.new(0,3,0.5,-10)
            knob.BackgroundColor3 = C.Text
        end
    end
    paint()

    btn.MouseButton1Click:Connect(function()
        on = not on
        S.Toggles[name] = on
        paint()
        if cb then task.spawn(function() pcall(cb, on) end) end
    end)

    S["setToggle_"..name] = function(v)
        if on ~= v then
            on = v
            S.Toggles[name] = v
            paint()
            if cb then task.spawn(function() pcall(cb, v) end) end
        end
    end
end
