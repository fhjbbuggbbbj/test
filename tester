    local function scanGame()
        local res = {remotes={},scripts={},values={},npcs={},tools={}}
        local function scanContainer(c, d)
            if d > 4 then return end
            for _,o in ipairs(c:GetChildren()) do
                pcall(function()
                    if o:IsA("RemoteEvent") or o:IsA("RemoteFunction") then
                        if #res.remotes < 30 then res.remotes[#res.remotes+1] = o:GetFullName() end
                    elseif o:IsA("Script") or o:IsA("LocalScript") or o:IsA("ModuleScript") then
                        if #res.scripts < 20 then res.scripts[#res.scripts+1] = o.Name end
                    elseif o:IsA("Tool") then
                        if #res.tools < 10 then res.tools[#res.tools+1] = o.Name end
                    elseif o:IsA("IntValue") or o:IsA("NumberValue") or o:IsA("StringValue") then
                        local ln = o.Name:lower()
                        if ln:find("cash") or ln:find("coin") or ln:find("money") or ln:find("gem") or ln:find("level") or ln:find("xp") then
                            if #res.values < 10 then res.values[#res.values+1] = o.Name.." = "..tostring(o.Value) end
                        end
                    end
                    if #o:GetChildren() > 0 then scanContainer(o, d+1) end
                end)
            end
        end
        pcall(function() scanContainer(RSS, 0) end)
        pcall(function() scanContainer(WS, 0) end)
        pcall(function()
            for _,o in ipairs(WS:GetDescendants()) do
                if o:IsA("Humanoid") and o.Parent and not PL:GetPlayerFromCharacter(o.Parent) then
                    if #res.npcs < 10 then res.npcs[#res.npcs+1] = o.Parent.Name end
                end
            end
        end)
        return res
    end

