    if i.KeyCode == Enum.KeyCode.End then gui.Enabled = not gui.Enabled end
end)

-- gameplay loops
RS.Heartbeat:Connect(function()
    if _G.infJump and LP.Character then
        local h = LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

local fbv, fbg
RS.RenderStepped:Connect(function()
    if _G.flyEnabled and LP.Character then
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp and not fbv then
            fbv = Instance.new("BodyVelocity"); fbv.MaxForce = Vector3.new(1e5,1e5,1e5); fbv.Velocity = Vector3.zero; fbv.Parent = hrp
            fbg = Instance.new("BodyGyro"); fbg.MaxTorque = Vector3.new(1e5,1e5,1e5); fbg.P = 1000; fbg.Parent = hrp
        elseif hrp and fbv then
            local cam = workspace.CurrentCamera
            local mv = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then mv = mv + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then mv = mv - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then mv = mv - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then mv = mv + cam.CFrame.RightVector end
            fbv.Velocity = mv * 60
            fbg.CFrame = cam.CFrame
        end
    elseif not _G.flyEnabled and fbv then
        pcall(function() fbv:Destroy(); fbg:Destroy() end)
        fbv, fbg = nil, nil
    end
end)

RS.Stepped:Connect(function()
    if _G.noclipEnabled and LP.Character then
        for _, p in pairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

local espF = N("Folder",{Name="NonoESP"}, gui)
local boxes = {}
local espAccum = 0
RS.RenderStepped:Connect(function(dt)
    if not _G.espEnabled then
        if next(boxes) then
            for _, b in pairs(boxes) do pcall(function() b:Destroy() end) end
            boxes = {}
        end
        return
    end
    espAccum = espAccum + dt
    if espAccum < 0.1 then return end
    espAccum = 0
    for _, plr in pairs(PL:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not boxes[plr] then
                    local b = Instance.new("BoxHandleAdornment")
                    b.Name = plr.Name
                    b.AlwaysOnTop = true
                    b.ZIndex = 5
                    b.Size = Vector3.new(2,2,1)
                    b.Transparency = 0.5
                    b.Color3 = C.Bad
                    b.Parent = espF
                    boxes[plr] = b
                end
                boxes[plr].Adornee = hrp
            end
        end
    end
end)

