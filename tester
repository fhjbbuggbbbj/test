-- frames (tab panels) will use Card background from their children

local function applyTheme()
    for _,e in ipairs(themeTargets) do
        pcall(function() e.o[e.p] = C[e.k] end)
    end
    -- recolor all descendants by tag (simple approach: walk and re-tint Card-coloured frames)
    for _,desc in ipairs(W:GetDescendants()) do
        pcall(function()
            if desc:IsA("Frame") or desc:IsA("TextButton") then
                if desc.BackgroundColor3 == C.BG then desc.BackgroundColor3 = C.BG end
            end
        end)
    end
end

