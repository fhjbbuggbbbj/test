local function N(c,p,par)
    local ok, o = pcall(Instance.new, c)
    if not ok or not o then return nil end
    for k,v in pairs(p or {}) do pcall(function() o[k] = v end) end
    if par then pcall(function() o.Parent = par end) end
    return o
end
local function Cnr(p,r) return N("UICorner",{CornerRadius=UDim.new(0,r or 8)},p) end
local function Strk(p,c,t) return N("UIStroke",{Color=c or C.Line,Thickness=t or 1},p) end
local function Pad(p,t,b,l,r) return N("UIPadding",{PaddingTop=UDim.new(0,t or 0),PaddingBottom=UDim.new(0,b or 0),PaddingLeft=UDim.new(0,l or 0),PaddingRight=UDim.new(0,r or 0)},p) end

-- icon drawing (same as before)
local function drawIcon(parent, kind, size, color)
    local c = color or C.Text
    local h = N("Frame",{Size=UDim2.new(0,size,0,size),BackgroundTransparency=1},parent)
    if not h then return end
    local function bar(x,y,w,ht,rot)
        local b = N("Frame",{
            Size=UDim2.new(0,w,0,ht),
            Position=UDim2.new(0,x,0,y),
            BackgroundColor3=c,
            BorderSizePixel=0,
            Rotation=rot or 0,
        },h)
        Cnr(b, math.max(1, math.min(w,ht)/2))
        return b
    end
    if kind == "rejoin" then
        local ring = N("Frame",{Size=UDim2.new(0,size-5,0,size-5),Position=UDim2.new(0,2,0,3),BackgroundTransparency=1},h)
        Cnr(ring,size)
        N("UIStroke",{Color=c,Thickness=2},ring)
        N("Frame",{Size=UDim2.new(0,size/2,0,size/2),Position=UDim2.new(0,size/2-2,0,-1),BackgroundColor3=C.Card,BorderSizePixel=0},h)
        bar(size-7, 1, 6, 2, 40)
        bar(size-7, 5, 6, 2, -40)
    elseif kind == "hop" then
        local circ = N("Frame",{Size=UDim2.new(0,size-5,0,size-5),Position=UDim2.new(0,2,0,2),BackgroundTransparency=1},h)
        Cnr(circ,size)
        N("UIStroke",{Color=c,Thickness=2},circ)
        bar(3, size/2-1, size-6, 2)
        bar(size/2-1, 3, 2, size-6)
    elseif kind == "copy" then
        local r1 = N("Frame",{Size=UDim2.new(0,size-9,0,size-9),Position=UDim2.new(0,0,0,0),BackgroundColor3=C.Card,BorderSizePixel=0},h)
        Cnr(r1,2)
        N("UIStroke",{Color=c,Thickness=1.5},r1)
        local r2 = N("Frame",{Size=UDim2.new(0,size-9,0,size-9),Position=UDim2.new(0,6,0,6),BackgroundColor3=C.Card,BorderSizePixel=0},h)
        Cnr(r2,2)
        N("UIStroke",{Color=c,Thickness=1.5},r2)
    elseif kind == "search" then
        local circ = N("Frame",{Size=UDim2.new(0,size-8,0,size-8),Position=UDim2.new(0,0,0,0),BackgroundTransparency=1},h)
        Cnr(circ,size)
        N("UIStroke",{Color=c,Thickness=2},circ)
        bar(size-9, size-9, 6, 2, 45)
    elseif kind == "close" then
        bar(size/2-1, 3, 2, size-6, 45)
        bar(size/2-1, 3, 2, size-6, -45)
    elseif kind == "min" then
        bar(3, size/2-1, size-6, 2)
    end
    return h
end

